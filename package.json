{
  "name": "gridsentinel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sync-layers": "node scripts/sync-layers.mjs",
    "predev": "node scripts/sync-layers.mjs",
    "prebuild": "node scripts/sync-layers.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify:physics": "tsx scripts/verify-physics.ts",
    "verify:owner": "for script in scripts/verify-owner-*.ts; do tsx \"$script\" || exit 1; done",
    "test:etl": "tsx --test \"research/etl/*.test.ts\" \"lib/**/*.test.ts\" \"components/**/*.test.ts\"",
    "test:service": "${PYTHON:-python3} -m pytest research/etl/test_service.py",
    "typecheck": "tsc --noEmit",
    "evidence:build": "tsx research/cli.ts build --profile westminster-100mi",
    "evidence:verify": "tsx research/cli.ts verify --bundle public/evidence/westminster-100mi.json",
    "evidence:verify:files": "tsx research/cli.ts verify --bundle public/evidence/westminster-100mi.json --files --strict",
    "evidence:discover": "tsx research/cli.ts discover",
    "evidence:report": "tsx research/cli.ts report --bundle public/evidence/westminster-100mi.json",
    "evidence:hash": "tsx research/cli.ts hash",
    "evidence:sources": "tsx research/cli.ts sources",
    "evidence:profiles": "tsx research/cli.ts profiles"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.0",
    "@google/genai": "^1.20.0",
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.18.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.1.0",
    "resend": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
