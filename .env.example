# Copy to .env.local and fill in what you have. Every feature degrades gracefully
# to a deterministic local fallback when a key is missing, so the demo always runs.

# Google Gemini — used by POST /api/generate-brief
GEMINI_API_KEY=""
# Override the model if the default is unavailable on your key.
GEMINI_MODEL="gemini-2.5-flash"

# Resend — used by POST /api/send-audit (requires a verified sender domain)
RESEND_API_KEY=""
AUDIT_FROM_EMAIL="Mapergy Audits <audits@resend.dev>"

# Prefilled recipient for the live email demo. The address an audit is actually
# delivered to is chosen in the Provider Action tab.
DEMO_INBOX_EMAIL=""

# Supabase — read-only reference datasets (regions, load centers, grid layers,
# niche cases, hourly line ratings) and the owner portal. Both values are public
# (publishable key + RLS). If the URL or key is empty, or a query fails, the app
# reads data/ and public/layers/. The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_URL="https://kqqbbtlawfcjrylecfxt.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
